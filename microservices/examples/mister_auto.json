{
    "name": "mister-auto",
    "description": "Comprehensive crawler for mister-auto",
    "config": {
        "start_urls": [
            "https://www.mister-auto.es"
        ],
        "max_depth": 3,
        "rate_limit_delay": 2000,
        "phases": [
            {
                "id": "discover_categories",
                "type": "discovery",
                "name": "Discover Main Product Categories",
                "nodes": [
                    {
                        "id": "navigate_to_homepage",
                        "type": "navigate",
                        "name": "Navigate to Homepage",
                        "params": {
                            "url": "{{start_url}}"
                        }
                    },
                    {
                        "id": "discover_main_categories",
                        "type": "extract_links",
                        "name": "Extract Category Links",
                        "params": {
                            "selector": "ul.container.fx-items-center.ma-list li a",
                            "marker": "category",
                            "limit": 2
                        },
                        "probe_url": "https://www.mister-auto.es"
                    }
                ],
                "url_filter": {
                    "depth": 0
                },
                "transition": {
                    "condition": "all_nodes_complete",
                    "next_phase": "discover_products"
                }
            },
            {
                "id": "discover_products",
                "type": "discovery",
                "name": "Discover Product Listing Pages",
                "nodes": [
                    {
                        "id": "navigate_to_category",
                        "type": "navigate",
                        "name": "Navigate to Category Page",
                        "params": {
                            "url": "{{current_url}}",
                            "driver": "chromedp"
                        }
                    },
                    {
                        "id": "discover_product_listings",
                        "type": "extract_links",
                        "name": "Extract Product Links",
                        "params": {
                            "selector": ".vertical-product a.ma-links",
                            "marker": "product",
                            "limit": 5
                        },
                        "probe_url": "https://www.mister-auto.es/neumaticos/"
                    }
                ],
                "url_filter": {
                    "markers": [
                        "category"
                    ]
                },
                "transition": {
                    "condition": "all_nodes_complete",
                    "next_phase": "extract_product_data"
                }
            },
            {
                "id": "extract_product_data",
                "type": "extraction",
                "name": "Extract Product Details",
                "nodes": [
                    {
                        "id": "navigate_to_product",
                        "type": "navigate",
                        "name": "Navigate to Product Page",
                        "params": {
                            "url": "{{current_url}}",
                            "driver": "http"
                        }
                    },
                    {
                        "id": "extract_aqua_product_data",
                        "type": "extract",
                        "name": "Extract Aqua Product Details",
                        "params": {
                            "schema": "aqua_product",
                            "fields": {
                                "page_title": {
                                    "selector": "title",
                                    "type": "text",
                                    "transform": "trim"
                                },
                                "product_name": {
                                    "selector": "#product-item-main-container .abt-listing-title",
                                    "type": "text",
                                    "transform": "trim",
                                    "required": true
                                }
                            }
                        },
                        "probe_url": "https://www.mister-auto.es/neumaticos-michelin-921-mic698-p/"
                    }
                ],
                "url_filter": {
                    "markers": [
                        "product"
                    ]
                }
            }
        ]
    },
    "status": "active"
}