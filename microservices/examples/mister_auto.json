{
    "name": "mister-auto.es",
    "description": "mister-auto.es",
    "config": {
        "start_urls": [
            "https://www.mister-auto.es/filtro-de-aire-8-g/"
        ],
        "max_depth": 3,
        "rate_limit_delay": 2000,
        "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
        },
        "phases": [
            {
                "id": "discover_categories",
                "type": "discovery",
                "name": "Discover Main Product Categories",
                "nodes": [
                    {
                        "id": "navigate_to_homepage",
                        "type": "navigate",
                        "name": "Navigate to Homepage",
                        "params": {
                            "url": "{{start_url}}"
                        }
                    },
                    {
                        "id": "discover_main_categories",
                        "type": "extract_links",
                        "name": "Extract Category Links",
                        "params": {
                            "selector": ".listing-title a",
                            "marker": "category",
                            "limit": 2
                        },
                        "probe_url": "https://www.mister-auto.es/filtro-de-aire-8-g/"
                    }
                ],
                "url_filter": {
                    "depth": 0
                },
                "transition": {
                    "condition": "all_nodes_complete",
                    "next_phase": "extract_product_data"
                }
            },
            {
                "id": "extract_product_data",
                "type": "extraction",
                "name": "Extract Product Details",
                "nodes": [
                    {
                        "id": "navigate_to_product",
                        "type": "navigate",
                        "name": "Navigate to Product Page",
                        "params": {
                            "url": "{{current_url}}",
                            "driver": "http"
                        }
                    },
                    {
                        "id": "extract_aqua_product_data",
                        "type": "extract",
                        "name": "Extract Aqua Product Details",
                        "params": {
                            "schema": "aqua_product",
                            "fields": {
                                "page_title": {
                                    "selector": "title",
                                    "type": "text",
                                    "transform": "trim"
                                },
                                "product_name": {
                                    "selector": ".product-title .abt-listing-title",
                                    "type": "text",
                                    "transform": "trim",
                                    "required": true
                                },
                                "images": {
                                    "selector": ".product-card-pictures .slick-list .slick-track img",
                                    "type": "attr",
                                    "attribute": "src",
                                    "multiple": true
                                },
                                "list_price": {
                                    "selector": ".product-card-details .medium-price--std",
                                    "type": "text",
                                    "transform": "trim",
                                    "default": "0"
                                }
                            }
                        },
                        "probe_url": "https://www.mister-auto.es/filtro-de-aire-mann-filter-004-c27009-p/"
                    }
                ],
                "url_filter": {
                    "markers": [
                        "product"
                    ]
                }
            }
        ]
    },
    "status": "active"
}